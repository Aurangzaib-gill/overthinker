{
  "name": "Email to Auto-Reply Draft",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "isUnread": true
        }
      },
      "id": "gmail_trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "modelId": "gpt-4-turbo-preview",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "=You are an AI assistant for Nexus Immigration Services in Pakistan. Analyze the email and extract:\n\n1. destination_country (Canada, UK, Australia, USA, etc.)\n2. visa_type (Study, Work, Visit, PR, Family)\n3. missing_documents (array of what to request: IELTS, CGPA, bank statements, passport copy, etc.)\n\nRespond ONLY with valid JSON."
            },
            {
              "role": "user",
              "content": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.text }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "gpt_analysis",
      "name": "GPT Analysis",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "modelId": "gpt-4-turbo-preview",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "=You are a professional email writer for Nexus Immigration Services in Pakistan.\n\nWrite a personalized email reply:\n- Start with 'Salam' or 'Dear [Name]'\n- Thank them for contacting Nexus Immigration Services\n- Show expertise about their visa type\n- Request missing documents politely\n- Ask follow-up questions (intake dates, timelines)\n- End with 'Best regards, Nexus Immigration Services Team'\n- Maximum 150 words\n\nWrite ONLY the email body."
            },
            {
              "role": "user",
              "content": "=Client: {{ $('Gmail Trigger').item.json.from }}\nCountry: {{ JSON.parse($json.choices[0].message.content).destination_country }}\nVisa: {{ JSON.parse($json.choices[0].message.content).visa_type }}\nMissing Docs: {{ JSON.stringify(JSON.parse($json.choices[0].message.content).missing_documents) }}\n\nOriginal Email:\n{{ $('Gmail Trigger').item.json.text }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "id": "generate_draft",
      "name": "Generate Draft",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "message": "={{ $json.choices[0].message.content }}",
        "subject": "=Re: {{ $('Gmail Trigger').item.json.subject }}",
        "toList": "={{ $('Gmail Trigger').item.json.from }}",
        "options": {
          "threadId": "={{ $('Gmail Trigger').item.json.threadId }}"
        }
      },
      "id": "create_draft",
      "name": "Create Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "GPT Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GPT Analysis": {
      "main": [
        [
          {
            "node": "Generate Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Draft": {
      "main": [
        [
          {
            "node": "Create Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
